{
	"name": "tags-color-files",
	"version": "2.2.0",
	"description": "Color files in file explorer automatically, based on the tags they contain and the rules you create.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "npm run lint:ts && npm run lint:css",
		"lint:ts": "eslint .",
		"lint:css": "stylelint \"**/*.css\" --ignore-disables",
		"lint:fix": "eslint --fix . && stylelint \"**/*.css\" --fix"
	},
	"keywords": [],
	"author": "pan4ratte",
	"license": "AGPL-3.0",
	"devDependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@types/node": "^25.9.2",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"esbuild": "^0.28.0",
		"eslint": "^10.11.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.11.4",
		"stylelint": "^17.15.0",
		"stylelint-config-obsidianmd": "^0.1.0",
		"ts-loader": "^9.5.4",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"webpack": "^5.105.0",
		"webpack-cli": "^6.0.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pan4ratte/obsidian-tags-color-files.git"
	},
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/pan4ratte/obsidian-tags-color-files/issues"
	},
	"homepage": "https://github.com/pan4ratte/obsidian-tags-color-files#readme"
}
